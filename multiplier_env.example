# Multiplier Bot — Deriv HMA + Mladen Flow
# Copia este archivo a .env y edita los valores antes de ejecutar.

# Token de API de Deriv (demo). Si no se define, el bot corre en PAPER.
DERIV_TOKEN=tu_token_de_demo_aqui

# Símbolo a operar (ej: 1HZ50V, R_100, etc.)
DERIV_SYMBOL=1HZ50V

# Stake por contrato (USD)
DERIV_STAKE=10.0

# Multiplicador de apalancamiento (x40, x100, x400, etc.)
DERIV_MULTIPLIER=100

# Modo demo (true = demo/paper, false = real)
DERIV_DEMO=true

# Parámetros de la estrategia
DERIV_HMA_PERIOD=20
DERIV_FLOW_PERIOD=14
DERIV_FLOW_SMOOTH=3
DERIV_FLOW_THRESHOLD=0.0

# Take profit y Stop loss en porcentaje del precio de entrada
# Ej: 0.001 = 0.1% de movimiento del precio
DERIV_TP_PCT=0.001
DERIV_SL_PCT=0.001

# Logging
DERIV_LOG_LEVEL=INFO
DERIV_LOG_FILE=multiplier_bot.log
