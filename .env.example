# --- 1HZ50V HMA + Mladen Flow Bot (Raspberry Pi) ---
# Copia este archivo a la Pi como .env y edita los valores.

# Deriv API token (demo). Obténlo en Deriv → Settings → API Tokens
# Si no se define, el bot corre en PAPER.
DERIV_TOKEN=tu_token_de_demo_aqui

# Símbolo a operar
DERIV_SYMBOL=1HZ50V

# Stake por contrato (USD)
DERIV_STAKE=10.0

# Duración del contrato en minutos
DERIV_DURATION=1
DERIV_DURATION_UNIT=m

# Modo demo
DERIV_DEMO=true

# Parámetros de la estrategia (óptimos del sweep 1HZ50V)
DERIV_HMA_PERIOD=20
DERIV_FLOW_PERIOD=14
DERIV_FLOW_SMOOTH=3
DERIV_FLOW_THRESHOLD=0.0

# Martingala
DERIV_MARTINGALE_MULT=2.4
DERIV_MAX_MARTINGALE_STEPS=4

# Gestión de riesgo
DERIV_STOP_AFTER_LOSSES=5
DERIV_MAX_DAILY_LOSS=50.0

# Logging
DERIV_LOG_LEVEL=INFO
DERIV_LOG_FILE=bot_1hz50v.log

# OTP para trading (Nuevo endpoint de Deriv)
DERIV_ACCOUNT_ID=DOTxxxxx   # ID de cuenta Options Trading
DERIV_APP_ID=1089           # App ID (requerido para PAT)
